# Port the proxy listens on inside the container.
PORT=8787

# Model providers: gemini (default), groq, glm. Only keys of providers in a chain are required.
PROVIDER=gemini
# Ordered fallback chains (first provider tried first; all fail -> 502/504).
# Unset -> PROVIDER only.
TEXT_PROVIDERS=gemini,groq,glm
IMAGE_PROVIDERS=gemini,groq,glm
# Chain budgets, kept below the mobile timeouts (text 20s, image 55s).
# Every attempt except the last is capped by *_ATTEMPT_TIMEOUT_MS.
TEXT_DEADLINE_MS=18000
TEXT_ATTEMPT_TIMEOUT_MS=8000
IMAGE_DEADLINE_MS=50000
IMAGE_ATTEMPT_TIMEOUT_MS=25000
# A provider that answers 429 (quota/overload) is skipped for this long.
PROVIDER_COOLDOWN_MS=60000

# Server-side-only Groq key, used when groq is in a chain (OpenAI-compatible API).
# Text: gpt-oss (production). Vision: qwen3.8-27b (Groq preview model).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-20b

# Server-side-only GLM (Zhipu/Z.ai) key, used when PROVIDER=glm.
# Mainland endpoint: https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.5v
GLM_TEXT_MODEL=glm-4.5-flash

# Server-side-only Gemini API key. Never ship this to the mobile app.
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.0-flash

# Optional static app-level token the mobile app sends back (not a user credential,
# just a cheap deterrent against random internet traffic hitting the endpoint).
# Leave blank to disable the check entirely.
PROXY_SHARED_TOKEN=

# Hard caps. When exceeded, the proxy answers 429 { "error": "LIMIT_EXCEEDED" }
# and resets at local midnight (server clock).
MAX_REQUESTS_PER_DAY=300
MAX_ESTIMATED_COST_USD_PER_DAY=5
ESTIMATED_COST_USD_PER_REQUEST=0.01

# Upstream call timeout before the proxy answers 504 { "error": "PROVIDER_TIMEOUT" }.
PROVIDER_TIMEOUT_MS=20000

# Reject uploads above this size before they ever reach memory processing.
MAX_IMAGE_BYTES=8388608

# Optional: model for the text routes (/parse-food-text, /parse-nutrition-text).
# Image routes always use GEMINI_MODEL. Falls back to GEMINI_MODEL when unset.
GEMINI_TEXT_MODEL=

# change 020: max characters for POST /parse-nutrition-text (pasted/OCR'd text).
MAX_NUTRITION_TEXT_CHARS=4000


# change 017: app version config served at GET /app-config (public, no token).
# Leave both versions empty to disable (endpoint returns 404, app stays fail-open).
# Bump APP_LATEST_VERSION only after the build is live in the stores.
# Change APP_MIN_SUPPORTED_VERSION only deliberately: it forces every older app to update.
APP_LATEST_VERSION=
APP_MIN_SUPPORTED_VERSION=
APP_RELEASE_NOTES=
APP_STORE_URL_ANDROID=
APP_STORE_URL_IOS=
